{
  /* The app itself: everything under src/, checked by `bun run typecheck`.
     vite.config.ts is checked separately by tsconfig.node.json (it needs the
     Node globals the browser code must not see), and edge/shared/index.ts is
     Deno source that is not part of the Vite build — neither belongs here. */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,

    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "types": ["vite/client"]
  },
  "include": ["src"]
}
